function(check mode)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=NORTHSTARCPP_PERLIN_PLUGIN
        ${ARGN} "${program}" "${mode}" RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Perlin ${mode} probe exited with ${result}")
    endif()
endfunction()

file(REMOVE_RECURSE "${ROOT}")
file(MAKE_DIRECTORY "${ROOT}/plugins")
get_filename_component(program_name "${PROBE}" NAME)
set(program "${ROOT}/${program_name}")
file(COPY "${PROBE}" DESTINATION "${ROOT}")
get_filename_component(extension "${EXTERNAL}" EXT)
file(WRITE "${ROOT}/bootstrap.json" "{\"plugins\":{\"path\":\"plugins\"}}\n")
check(builtin)
configure_file("${INVALID}" "${ROOT}/plugins/00_invalid${extension}" COPYONLY)
check(builtin)
check(reject "NORTHSTARCPP_PERLIN_PLUGIN=${INVALID}")
configure_file("${EXTERNAL}" "${ROOT}/plugins/01_external${extension}" COPYONLY)
check(external)
file(REMOVE "${ROOT}/plugins/01_external${extension}")
file(WRITE "${ROOT}/bootstrap.json"
    "{\"plugins\":{\"path\":\"plugins\",\"overrides\":{\"engine.perlin\":\"configured${extension}\"}}}\n")
configure_file("${EXTERNAL}" "${ROOT}/configured${extension}" COPYONLY)
check(external)
check(reject "NORTHSTARCPP_PERLIN_PLUGIN=${INVALID}")
file(REMOVE "${ROOT}/bootstrap.json" "${ROOT}/configured${extension}")
check(builtin)
