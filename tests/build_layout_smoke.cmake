cmake_minimum_required(VERSION 3.21)
if(NOT DEFINED ROOT OR NOT IS_DIRECTORY "${ROOT}")
    message(FATAL_ERROR "Pass -DROOT=<source checkout>")
endif()
set(PROJECT_SOURCE_DIR "${ROOT}")
if(TEST_INVALID)
    set(CMAKE_BINARY_DIR "${ROOT}/out/gcc-debug")
else()
    set(CMAKE_BINARY_DIR "${ROOT}/out/build")
endif()
include("${ROOT}/tools/cmake/NorthStarBuildLayout.cmake")
if(NOT NORTHSTARCPP_BUILD_OUTPUT_ROOT STREQUAL CMAKE_BINARY_DIR)
    message(FATAL_ERROR "Wrong generated-output root")
endif()
message(STATUS "NorthStarCpp layout policy PASS: ${NORTHSTARCPP_BUILD_OUTPUT_ROOT}")
