# Windows File Properties for all first-party EXE/DLL targets.
# This module is applied after the project has declared its targets.
include_guard(GLOBAL)
set(NORTHSTARCPP_FILEINFO_TEMPLATE "${CMAKE_CURRENT_LIST_DIR}/NorthStarFileInfo.rc.in")

function(northstarcpp_attach_fileinfo target)
    if(NOT WIN32 OR NOT TARGET "${target}")
        return()
    endif()
    get_target_property(_type "${target}" TYPE)
    if(NOT _type MATCHES "^(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY)$")
        return()
    endif()
    # Both own complete VERSIONINFO resources and must not get a second one.
    if(target STREQUAL "bugtrap" OR target STREQUAL "shader_generator")
        return()
    endif()
    get_target_property(_attached "${target}" NORTHSTARCPP_FILEINFO_ATTACHED)
    if(_attached)
        return()
    endif()

    get_target_property(_basename "${target}" OUTPUT_NAME)
    if(NOT _basename)
        set(_basename "${target}")
    endif()
    if(_type STREQUAL "EXECUTABLE")
        set(NS_FILE_TYPE VFT_APP)
        set(NS_FILE_ORIGINAL "${_basename}${CMAKE_EXECUTABLE_SUFFIX}")
    else()
        set(NS_FILE_TYPE VFT_DLL)
        get_target_property(_prefix "${target}" PREFIX)
        if(_prefix MATCHES "-NOTFOUND$")
            if(_type STREQUAL "MODULE_LIBRARY")
                set(_prefix "${CMAKE_SHARED_MODULE_PREFIX}")
            else()
                set(_prefix "${CMAKE_SHARED_LIBRARY_PREFIX}")
            endif()
        endif()
        get_target_property(_suffix "${target}" SUFFIX)
        if(_suffix MATCHES "-NOTFOUND$")
            if(_type STREQUAL "MODULE_LIBRARY")
                set(_suffix "${CMAKE_SHARED_MODULE_SUFFIX}")
            else()
                set(_suffix "${CMAKE_SHARED_LIBRARY_SUFFIX}")
            endif()
        endif()
        set(NS_FILE_ORIGINAL "${_prefix}${_basename}${_suffix}")
    endif()
    set(NS_FILE_INTERNAL "${_basename}")
    get_target_property(_capability "${target}" NORTHSTARCPP_MODULE_CAPABILITY)
    get_target_property(_provider "${target}" NORTHSTARCPP_MODULE_PROVIDER)
    if(_capability AND _provider)
        set(NS_FILE_DESCRIPTION
            "NorthStar Engine ${_capability} provider (${_provider})")
        set(NS_FILE_COMMENTS
            "Interchangeable NorthStar engine.${_capability} plugin")
    elseif(target STREQUAL "northstarcpp_project_manager")
        set(NS_FILE_DESCRIPTION "NorthStar Project Manager")
        set(NS_FILE_COMMENTS "Project discovery and engine provider configuration")
    elseif(target STREQUAL "northstarcpp_editor_qt")
        set(NS_FILE_DESCRIPTION "NorthStar Editor")
        set(NS_FILE_COMMENTS "Native Qt scene and asset editor")
    elseif(target STREQUAL "northstarcpp_player")
        set(NS_FILE_DESCRIPTION "NorthStar Player")
        set(NS_FILE_COMMENTS "NorthStar runtime and game launcher")
    elseif(target STREQUAL "northstarcpp_asset_browser")
        set(NS_FILE_DESCRIPTION "NorthStar Asset Browser")
        set(NS_FILE_COMMENTS "Native asset inspection and authoring")
    elseif(target STREQUAL "northstarcpp_camera_timeline_editor")
        set(NS_FILE_DESCRIPTION "NorthStar Camera Timeline Editor")
        set(NS_FILE_COMMENTS "Camera animation authoring")
    elseif(target STREQUAL "northstarcpp_gpu_provider_probe")
        set(NS_FILE_DESCRIPTION "NorthStar GPU Provider Probe")
        set(NS_FILE_COMMENTS "Render backend device and capability diagnostics")
    elseif(target STREQUAL "northstarcpp_scene_convert")
        set(NS_FILE_DESCRIPTION "NorthStar Scene Converter")
        set(NS_FILE_COMMENTS "Native scene conversion tool")
    elseif(target STREQUAL "perlin_world_generator")
        set(NS_FILE_DESCRIPTION "NorthStar World Generator")
        set(NS_FILE_COMMENTS "Procedural world generation tool")
    elseif(target MATCHES "(_smoke|_qa|_fixture|_test)$")
        set(NS_FILE_DESCRIPTION "NorthStar Engine Test - ${_basename}")
        set(NS_FILE_COMMENTS "Internal testing and verification executable")
    else()
        set(NS_FILE_DESCRIPTION "NorthStar Engine - ${_basename}")
        set(NS_FILE_COMMENTS "First-party NorthStar Engine component")
    endif()

    set(NS_FILE_PRODUCT "NorthStarCpp Engine")
    set(NS_FILE_COMPANY "Kayla's Systems")
    set(NS_FILE_COPYRIGHT "Copyright (C) 2026 Kayla's Systems - Kayla Verner")

    set(_file "${PROJECT_BINARY_DIR}/generated/fileinfo/${target}.rc")
    configure_file("${NORTHSTARCPP_FILEINFO_TEMPLATE}" "${_file}" @ONLY)
    target_sources("${target}" PRIVATE "${_file}")
    set_property(TARGET "${target}" PROPERTY NORTHSTARCPP_FILEINFO_ATTACHED TRUE)
    set_property(GLOBAL APPEND PROPERTY NORTHSTARCPP_FILEINFO_TARGETS "${target}")
endfunction()

# Restrict enumeration to the engine's own directories, not any dependencies
# (Qt, Bullet, Jolt, Flecs, third-party redistributables).
function(northstarcpp_attach_owned_fileinfo)
    if(NOT WIN32)
        return()
    endif()
    foreach(_directory IN LISTS ARGN)
        get_property(_targets DIRECTORY "${_directory}" PROPERTY BUILDSYSTEM_TARGETS)
        foreach(_target IN LISTS _targets)
            northstarcpp_attach_fileinfo("${_target}")
        endforeach()
    endforeach()
    get_property(_targets GLOBAL PROPERTY NORTHSTARCPP_FILEINFO_TARGETS)
    list(LENGTH _targets _count)
    message(STATUS "NorthStar Windows VERSIONINFO attached to ${_count} EXE/DLL targets")
endfunction()
