// Generated per-target Windows FileInfo. Do not edit build outputs.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @NS_FILE_TYPE@
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "@NS_FILE_COMPANY@\0"
            VALUE "FileDescription", "@NS_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "InternalName", "@NS_FILE_INTERNAL@\0"
            VALUE "LegalCopyright", "@NS_FILE_COPYRIGHT@\0"
            VALUE "OriginalFilename", "@NS_FILE_ORIGINAL@\0"
            VALUE "ProductName", "@NS_FILE_PRODUCT@\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0\0"
            VALUE "Comments", "@NS_FILE_COMMENTS@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
