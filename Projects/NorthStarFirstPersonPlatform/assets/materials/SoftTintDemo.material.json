{
  "schema": 1,
  "name": "Soft Tint Demo",
  "shader": "standard_lit",
  "base_color": "#b8bec7",
  "roughness": 0.45,
  "metallic": 0.12,
  "graph": {
    "nodes": [
      {
        "id": "base",
