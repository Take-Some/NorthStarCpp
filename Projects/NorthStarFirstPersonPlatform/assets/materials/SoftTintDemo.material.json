        "path": "MaterialFunctions/SoftTint.material-function.json",
        "output": "result",
        "inputs": {
          "color": "base",
          "mix": "ratio"
        },
        "x": 70,
        "y": 30
      }
    ],
    "outputs": {
      "base_color": "tone"
    }
  }
