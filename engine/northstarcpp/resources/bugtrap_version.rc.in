// Windows File Properties / FileInfo for NorthStarCpp BugTrap.
// Version numbers are generated from the authoritative CMake project version.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Kayla's Systems\0"
            VALUE "FileDescription", "NorthStarCpp BugTrap - Crash Reporter\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "InternalName", "bugtrap\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Kayla's Systems - Kayla Verner\0"
            VALUE "OriginalFilename", "bugtrap.exe\0"
            VALUE "ProductName", "NorthStarCpp Engine\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0\0"
            VALUE "Comments", "Native crash reporter. Reports and minidumps are stored locally.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
