#version 450
// Vulkan GPU skinning: original eight YDD bone influences, row-major 4x4
// palette ABI, and exactly the same 80-byte output as MaterialClipVertex.
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer SkinVertices {
    uint words[];
} skin;
layout(set=0,binding=1,std430) writeonly buffer ProjectedVertices {
    uint words[];
} projected;
layout(set=0,binding=2,std430) readonly buffer BoneMatrices {
    float matrix_values[];
} bones;
layout(push_constant) uniform SkinConstants {
    vec4 camera;
    vec4 angles;
    vec4 projection;
    vec4 tint;
    vec4 params;
    uvec4 offsets;
} control;
float fetch_float(uint index) {
    return uintBitsToFloat(skin.words[index]);
}
vec3 joint_point(uint joint,vec3 point,bool normal_only) {
    uint base=control.offsets.w+joint*16u;
    float w=normal_only?0.0:1.0;
    return vec3(
        point.x*bones.matrix_values[base+0u] +
        point.y*bones.matrix_values[base+4u] +
        point.z*bones.matrix_values[base+8u] + w*bones.matrix_values[base+12u],
        point.x*bones.matrix_values[base+1u] +
        point.y*bones.matrix_values[base+5u] +
        point.z*bones.matrix_values[base+9u] + w*bones.matrix_values[base+13u],
        point.x*bones.matrix_values[base+2u] +
        point.y*bones.matrix_values[base+6u] +
        point.z*bones.matrix_values[base+10u] + w*bones.matrix_values[base+14u]);
}
void main() {
    uint id=gl_GlobalInvocationID.x;
    if(id>=control.offsets.z)return;
    uint source=(control.offsets.x+id)*20u;
    uint target=(control.offsets.y+id)*20u;
    vec3 position=vec3(fetch_float(source),fetch_float(source+1u),
                       fetch_float(source+2u));
    vec3 normal=vec3(fetch_float(source+3u),fetch_float(source+4u),
                     fetch_float(source+5u));
    vec2 uv=vec2(fetch_float(source+6u),fetch_float(source+7u));
    vec3 world=vec3(0.0);
    vec3 world_normal=vec3(0.0);
    for(uint i=0u;i<8u;++i) {
        uint packed=skin.words[source+8u+i/2u];
        uint joint=(i%2u)==0u ? (packed&0xffffu) : (packed>>16u);
        float weight=fetch_float(source+12u+i);
        if(weight>0.0) {
            world+=joint_point(joint,position,false)*weight;
            world_normal+=joint_point(joint,normal,true)*weight;
        }
    }
    vec3 offset=world-control.camera.xyz;
    float horizontal=offset.x*control.angles.x-offset.z*control.angles.y;
    float forward=offset.x*control.angles.y+offset.z*control.angles.x;
    float vertical=offset.y*control.angles.z-forward*control.angles.w;
    float distance=offset.y*control.angles.w+forward*control.angles.z;
    float near_clip=control.projection.z,far_clip=control.projection.w;
    vec4 clip=vec4(
        horizontal*control.projection.x/control.projection.y,
        -vertical*control.projection.x,
        (far_clip*distance-far_clip*near_clip)/(far_clip-near_clip),
        distance);
    if(distance<=near_clip)clip=vec4(0.0,0.0,-1.0,1.0);
    projected.words[target+0u]=floatBitsToUint(clip.x);
    projected.words[target+1u]=floatBitsToUint(clip.y);
    projected.words[target+2u]=floatBitsToUint(clip.z);
    projected.words[target+3u]=floatBitsToUint(clip.w);
    projected.words[target+4u]=floatBitsToUint(uv.x);
    projected.words[target+5u]=floatBitsToUint(uv.y);
    projected.words[target+6u]=floatBitsToUint(world_normal.x);
    projected.words[target+7u]=floatBitsToUint(world_normal.y);
    projected.words[target+8u]=floatBitsToUint(world_normal.z);
    for(uint i=0u;i<4u;++i)
        projected.words[target+9u+i]=floatBitsToUint(control.tint[i]);
    for(uint i=0u;i<4u;++i)
        projected.words[target+13u+i]=floatBitsToUint(control.params[i]);
    projected.words[target+17u]=floatBitsToUint(world.x);
    projected.words[target+18u]=floatBitsToUint(world.y);
    projected.words[target+19u]=floatBitsToUint(world.z);
}
